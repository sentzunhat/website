{
  "name": "sentzunhat-website-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=26.0.0", "npm": ">=11.0.0" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit false --outDir dist && zacatl-fix-esm dist && node -e \"import('node:fs').then(fs => fs.writeFileSync('dist/package.json', '{\\\"type\\\":\\\"module\\\"}\\n'))\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sentzunhat/zacatl": "0.0.61",
    "@fastify/static": "^10.1.3",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
